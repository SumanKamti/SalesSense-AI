# ==========================================
# SalesSense AI — Environment Configuration
# ==========================================

# Application
APP_NAME="SalesSense AI"
APP_VERSION="1.0.0"
DEBUG=True

# Server
HOST="127.0.0.1"
PORT=8000

# Database Configuration (PostgreSQL)
# Format: postgresql://<username>:<password>@<host>:<port>/<database_name>
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/salessense_db"

# (Optional SQLite fallback example)
# DATABASE_URL="sqlite:///./salessense.db"

# Security (Generate a secure random string in production)
SECRET_KEY="replace-with-a-very-secure-random-secret-key"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI / Speech Recognition & Audio Processing
# Whisper Model: "small" (high accuracy, recommended) or "base" (fastest CPU)
WHISPER_MODEL="small"
WHISPER_COMPUTE_TYPE="int8"
AUDIO_PREPROCESSING_ENABLED=True

# AI / Speaker Diarization
# Choose "lightweight" (runs on CPU, fast) or "pyannote" (requires Hugging Face token)
DIARIZATION_ENGINE="lightweight"
HUGGINGFACE_TOKEN=""
DIARIZATION_MODEL="pyannote/speaker-diarization-3.1"

# AI / Google Gemini API (Get free key at https://aistudio.google.com)
GEMINI_API_KEY=""
